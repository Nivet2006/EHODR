# ==============================================================================
# UNIVERSAL AI MEMORY SYSTEM CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with secure, real values.
# DO NOT COMMIT THE ACTIVE .env FILE TO VERSION CONTROL.
# ==============================================================================

# --- FastAPI Gateway Port ---
GATEWAY_PORT=8000
API_SECRET_KEY=REPLACE_WITH_RANDOM_256BIT_HEX  # Generate with: openssl rand -hex 32
LOG_LEVEL=INFO

# --- Embedding Service Provider Config ---
# Supported providers: mock (100% free offline), ollama (100% free local), openai (paid API)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=sk-placeholder-key-or-blank-for-mock

# --- Local Ollama Config (Optional, 100% Free Semantic Embeddings) ---
# To use: set EMBEDDING_PROVIDER=ollama, EMBEDDING_MODEL to your local model, and EMBEDDING_DIMENSIONS (e.g. nomic-embed-text uses 768 dimensions)
# OLLAMA_URL=http://host.docker.internal:11434

# --- PostgreSQL Connection Parameters ---
POSTGRES_DB=memory_db
POSTGRES_USER=memory_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# For Docker network, connection points to host 'postgres'
DATABASE_URL=postgresql+asyncpg://memory_user:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/memory_db

# --- Redis Cache Parameters ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
# For Docker network, connection points to host 'redis'
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# --- Qdrant Vector DB Ports & Collection ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=ai_memories

# --- Memory Heuristics and Budgets ---
# Cosine similarity below this skips duplicate ingestion (de-duplication)
DEDUP_SIMILARITY_THRESHOLD=0.92
# Minimum importance score (0.0 to 1.0) needed to write to DB
MIN_IMPORTANCE_SCORE_TO_STORE=0.3
# Maximum cumulative tokens permitted in recalled prompt context
MAX_CONTEXT_TOKENS=4000
